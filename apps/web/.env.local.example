# Server-side calls use the API service directly.
NEXT_PUBLIC_API_URL=https://convergekit-dev.local

# SSR wiki routes intentionally call the web origin, matching production ingress.
NEXT_PUBLIC_WEB_URL=https://convergekit-dev.local

# In local dev, unmatched /api/* web-origin requests fall back to the API service.
LOCAL_API_PROXY_URL=http://localhost:4001
