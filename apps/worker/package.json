    "@convergekit/queues": "workspace:*",
    "@convergekit/types": "workspace:*",
    "ai": "^7.0.37",
    "bullmq": "^5.81.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
