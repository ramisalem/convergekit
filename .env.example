# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=convergekit
POSTGRES_PASSWORD=convergekit_secret
POSTGRES_DB=convergekit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://convergekit:convergekit_secret@localhost:5432/convergekit

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── AI Providers ────────────────────────────────────────────────────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# Optional fallback providers if you intentionally switch AI_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=https://convergekit-dev.local
API_BASE_URL=https://convergekit-dev.local
WEB_APP_URL=https://convergekit-dev.local
ALLOWED_ORIGINS=https://convergekit-dev.local
# The one GitHub account allowed to provision itself as the first admin. Required on a
# fresh deployment: until one admin exists, every SSO sign-in is refused with
# `bootstrap_admin_required`. Admins must sign in through GitHub, not SSO.
INITIAL_ADMIN_EMAIL=admin@example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ─── Workforce SSO (Authentik) ───────────────────────────────────────────────
# See docs/authentik-sso-setup.md for the full Authentik walkthrough.
WORKFORCE_SSO_ENABLED=false
WORKFORCE_SSO_PROVIDER_LABEL=Authentik
# SSO URL of the Authentik SAML provider (Redirect binding), e.g.
# https://authentik.example.com/application/saml/colab-ai-hub/sso/binding/redirect/
WORKFORCE_SAML_IDP_SSO_URL=
# Must exactly match the "Issuer" configured on the Authentik SAML provider
# (e.g. https://authentik.example.com, or the provider metadata URL if you kept
# Authentik's default issuer).
WORKFORCE_SAML_IDP_ENTITY_ID=
# Signing certificate of the Authentik provider. Supports one cert or multiple
# rollover certs as concatenated PEM blocks, comma-separated cert bodies, or
# escaped PEM strings with \n.
WORKFORCE_SAML_IDP_CERT=
WORKFORCE_SAML_SP_ENTITY_ID=urn:convergekit:dev
WORKFORCE_SAML_ACS_URL=https://convergekit-dev.local/api/auth/workforce-saml/acs
WORKFORCE_SAML_START_URL=https://convergekit-dev.local/en/auth/sign-in
CONVERGEKIT_SESSION_TTL_DAYS=14

# Only needed if you run the bundled Authentik container (compose.authentik.yaml).
# Generate the secret key with: openssl rand -base64 48
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=authentik_secret
AUTHENTIK_PORT=9000
# Optional: seed Authentik's `akadmin` on first boot instead of clicking through
# http://localhost:9000/if/flow/initial-setup/. The token is an API token for akadmin.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
# Pin a release from https://github.com/goauthentik/authentik/releases instead of latest.
AUTHENTIK_TAG=latest

# ─── Access policy ───────────────────────────────────────────────────────────
ACCESS_ALLOWED_EMAIL_DOMAIN=
ACCESS_ALLOWED_GITHUB_ORG=
ACCESS_ALLOWED_REPOSITORY_HOST=github.com
ACCESS_SUPPORT_ADMIN_EMAILS=

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=https://convergekit-dev.local
NEXT_PUBLIC_WEB_URL=https://convergekit-dev.local
LOCAL_API_PROXY_URL=http://localhost:4001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKSPACE_DIR=/tmp/convergekit-workspace
MAX_INDEX_FILE_BYTES=524288
INDEX_CHUNK_BATCH_SIZE=64
