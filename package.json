{
  "name": "convergekit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "overrides": {
      "defu": "6.1.7",
      "dompurify": "3.4.1",
      "esbuild": "0.28.0",
      "fast-uri": "3.1.2",
      "ip-address": "10.1.1",
      "kysely": "0.28.17",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "postcss": "8.5.12",
      "brace-expansion@5.0.5": "5.0.6",
      "shell-quote": "1.8.4",
      "uuid": "14.0.0",
      "vite": "8.0.16"
    }
  }
}
