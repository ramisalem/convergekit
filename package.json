{
  "name": "convergekit",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "typescript-eslint": "^8.59.4",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3"
  },
  "pnpm": {
    "overrides": {
      "defu": "6.1.7",
      "dompurify": "3.4.1",
      "esbuild": "0.28.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "postcss": "8.5.12",
      "uuid": "14.0.0",
      "vite": "8.0.10"
    }
  }
}
