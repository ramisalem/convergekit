{
  "name": "@convergekit/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./evidence-alignment": "./src/evidence-alignment.ts",
    "./evidence": "./src/evidence.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./redact": "./src/redact.ts",
    "./backfill-ci-token-capability": "./src/backfill-ci-token-capability.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx src/apply-manual-migrations.ts",
    "db:backfill:evidence": "tsx src/backfill-evidence-metadata.ts",
    "db:backfill:ci-tokens": "tsx src/backfill-ci-token-capability.ts",
    "db:deploy": "pnpm db:migrate && pnpm db:backfill:ci-tokens",
    "db:transfer-chat-history": "tsx src/maintenance/transfer-chat-history.ts",
    "db:validate:baseline": "tsx src/validate-migration-baseline.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convergekit/ai": "workspace:*",
    "@convergekit/types": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
