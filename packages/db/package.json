{
  "name": "@convergekit/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./evidence-alignment": "./src/evidence-alignment.ts",
    "./evidence": "./src/evidence.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx src/apply-manual-migrations.ts",
    "db:backfill:evidence": "tsx src/backfill-evidence-metadata.ts",
    "db:transfer-chat-history": "tsx src/maintenance/transfer-chat-history.ts",
    "db:validate:baseline": "tsx src/validate-migration-baseline.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convergekit/ai": "workspace:*",
    "@convergekit/types": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  }
}
